</main></div>
<script>
  // Micro-interactions for primary controls
  const saveBtn = document.getElementById('saveJobBtn');
  const saveText = document.getElementById('saveText');
  let isSaved = true;

  if (saveBtn && saveText) {
    saveBtn.addEventListener('click', () => {
      isSaved = !isSaved;
      if (isSaved) {
        saveText.innerText = 'Saved to Wishlist';
        saveBtn.classList.remove('opacity-70');
      } else {
        saveText.innerText = 'Save to Wishlist';
        saveBtn.classList.add('opacity-70');
      }
    });
  }

  const applyBtn = document.getElementById('applyBtn');
  if (applyBtn) {
    applyBtn.addEventListener('click', () => {
      applyBtn.innerHTML = `
        <span class="material-symbols-outlined animate-spin text-[20px]">progress_activity</span>
        <span>Submitting Dossier...</span>
      `;
      setTimeout(() => {
        applyBtn.innerHTML = `
          <span class="material-symbols-outlined text-[20px]">check</span>
          <span>Application Dispatched!</span>
        `;
        applyBtn.classList.remove('bg-secondary');
        applyBtn.classList.add('bg-tertiary-container', 'text-on-tertiary-container');
      }, 1200);
    });
  }

  const customizeBtn = document.getElementById('customizeBtn');
  if (customizeBtn) {
    customizeBtn.addEventListener('click', () => {
      customizeBtn.innerHTML = `
        <span class="material-symbols-outlined animate-pulse text-[18px]">auto_fix_high</span>
        <span>Synthesizing Cover Letter...</span>
      `;
      setTimeout(() => {
        customizeBtn.innerHTML = `
          <span class="material-symbols-outlined text-[18px]">description</span>
          <span>View Tailored Pitch Draft</span>
        `;
      }, 1000);
    });
  }
</script></body></html>